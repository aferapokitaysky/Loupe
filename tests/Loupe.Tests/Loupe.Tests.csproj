<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Loupe.Tests</RootNamespace>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!--
    A plain console runner rather than a test framework: it needs no extra packages, runs
    the same way locally and in CI, and exits non-zero on failure. Everything here is
    hermetic - the dissector works on hand-built frames, and the proxy tests talk to a
    loopback HTTP server, so no Npcap and no internet are required.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Loupe.Core\Loupe.Core.csproj" />
    <ProjectReference Include="..\..\src\Loupe.Proxy\Loupe.Proxy.csproj" />
    <!-- Only for ProcessPortMap, which reads the OS socket tables; nothing here loads Npcap. -->
    <ProjectReference Include="..\..\src\Loupe.Capture\Loupe.Capture.csproj" />
  </ItemGroup>

</Project>
