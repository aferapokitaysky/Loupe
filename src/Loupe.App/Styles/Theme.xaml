<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Near-monochrome graphite theme. Colour carries meaning here and nothing
        else: green/amber/red/blue mark protocol and status, everything
        structural is a shade of grey. Selection is white, not a brand hue.
        Layered on top of WPF-UI's Fluent styles via BasedOn, never replacing
        their control templates.
    -->

    <!-- Surfaces: each step up is a thin lift, not a new colour -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#0A0B0D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#191E24" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1F252C" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0C0F12" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2BFFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9ECEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA1A8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#646B73" />

    <!-- Semantic only -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
    <SolidColorBrush x:Key="WarnBrush" Color="#D29922" />
    <SolidColorBrush x:Key="InfoBrush" Color="#58A6FF" />

    <LinearGradientBrush x:Key="WindowScrimBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#F00E1115" />
        <GradientStop Offset="1" Color="#F6070809" />
    </LinearGradientBrush>

    <!-- Panels -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Toolbars sit in a card but need tighter, denser padding than content panels -->
    <Style x:Key="ToolbarCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,6,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Buttons: WPF-UI's Fluent look plus a short press response. No hover bounce. -->
    <Style x:Key="AppButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.07" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.07" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Nav rail item. The icon comes in as part of Content (a SymbolIcon +
        label) rather than through Tag: TemplateBinding does no type
        conversion, so a Tag string never becomes a SymbolRegular and the
        icon silently renders as nothing.
    -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Hover" CornerRadius="8" Background="{StaticResource SurfaceHoverBrush}" Opacity="0" />
                        <Border x:Name="Selected" CornerRadius="8" Background="{StaticResource SurfaceSelectedBrush}" Opacity="0" />
                        <Border x:Name="Marker" Width="2.5" CornerRadius="2" Margin="0,12"
                                HorizontalAlignment="Left" Background="{StaticResource TextPrimaryBrush}"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.3" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.3" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Language picker chip: flag only, so it fits the narrow rail; the list opens in a popup -->
    <Style x:Key="FlagChip" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" CornerRadius="7" Padding="8,6" Background="Transparent"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlagSwatch" TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="NavLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="13" />
    </Style>

    <!-- Hosts panel -->

    <!-- Square, so an icon that isn't square is letterboxed rather than stretched. -->
    <Style x:Key="FaviconTile" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Stands in for the favicon until one loads, and forever for hosts that have none. -->
    <Style x:Key="FaviconInitial" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HostName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HostMeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="HostBytes" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="HostListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="8" Padding="8,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Top bar ============================ -->

    <!--
        The toolbar reads left to right as one sentence: what you are capturing, the one button
        that starts it, then the things you do to what you captured, then what it adds up to.
        Secondary actions are icon-only inside a segmented strip so they stop competing with the
        primary one - which is the only coloured control in the row.
    -->
    <Style x:Key="ToolbarStrip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="ToolbarIconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape as the icon buttons, but it stays lit while the option is on. -->
    <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="4,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
    </Style>

    <!-- Live totals, right-aligned: number over label, monospaced so digits don't jitter. -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="BrandWordmark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Setup steps: grey while pending, green once done. Tag carries the done flag. -->
    <Style x:Key="StepChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Background" Value="#143FB950" />
                <Setter Property="BorderBrush" Value="#553FB950" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The same chip, but it does the step it names. A legend that only describes what to do
        elsewhere makes you find the elsewhere; this one is the button.
    -->
    <Style x:Key="StepButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" CornerRadius="16" Padding="12,6"
                            Background="{StaticResource SurfaceSunkenBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                        <!-- Done: green, and no longer inviting a click. -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#143FB950" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#553FB950" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StepNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="StepText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="StepCheck" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <!-- One saved session in the library -->
    <Style x:Key="SessionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="2,3" />
    </Style>

    <!-- Active filter: says what is narrowing the list and offers the one way out -->
    <Style x:Key="FilterChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,3,4,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipCloseButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="11">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Data grids -->
    <Style x:Key="AppColumnHeader" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SeparatorBrush" Value="{StaticResource BorderSubtleBrush}" />
    </Style>

    <Style x:Key="AppDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="26" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Empty states: one gentle fade-and-rise on appear, then still -->
    <Style x:Key="EmptyState" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="8" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="8" To="0" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmptyStateIcon" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- ============================ Tabs ============================

        Request and response, as a segmented header with the brand rule under the active one -
        the same shape as the toolbar toggles, so the two never look like different apps.
    -->
    <Style x:Key="AppTabItem" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Shell" Background="Transparent" CornerRadius="7" Padding="14,7" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Rule" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                Margin="14,0,18,0" Background="{StaticResource BrandNeonBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Rule" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="6,4,6,0" />
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,6,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Badges ============================

        A grid is read by scanning, not by reading. These carry the one word in each row that
        decides whether you look further - the protocol, the method, the status - as a shape and
        a colour, so the eye finds the interesting row without parsing the text of every line.

        Colour is keyed on the value through Tag rather than a converter per column: the value is
        already there, and a trigger list is the thing you read to learn what the colours mean.
    -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Protocol, in the same hues the old row tints used - just concentrated into one chip. -->
    <Style x:Key="ProtocolPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="MinWidth" Value="48" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="TLS"><Setter Property="Background" Value="#243FB950" /></Trigger>
            <Trigger Property="Tag" Value="QUIC"><Setter Property="Background" Value="#2456D364" /></Trigger>
            <Trigger Property="Tag" Value="HTTP"><Setter Property="Background" Value="#26D29922" /></Trigger>
            <Trigger Property="Tag" Value="DNS"><Setter Property="Background" Value="#2658A6FF" /></Trigger>
            <Trigger Property="Tag" Value="UDP"><Setter Property="Background" Value="#242DD4BF" /></Trigger>
            <Trigger Property="Tag" Value="ARP"><Setter Property="Background" Value="#22C9A0FF" /></Trigger>
            <Trigger Property="Tag" Value="ICMP"><Setter Property="Background" Value="#24F85149" /></Trigger>
            <Trigger Property="Tag" Value="ICMPv6"><Setter Property="Background" Value="#24F85149" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- HTTP method: the safe ones stay quiet, the ones that change something do not. -->
    <Style x:Key="MethodPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="MinWidth" Value="46" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="GET"><Setter Property="Background" Value="#2458A6FF" /></Trigger>
            <Trigger Property="Tag" Value="POST"><Setter Property="Background" Value="#243FB950" /></Trigger>
            <Trigger Property="Tag" Value="PUT"><Setter Property="Background" Value="#26D29922" /></Trigger>
            <Trigger Property="Tag" Value="PATCH"><Setter Property="Background" Value="#26D29922" /></Trigger>
            <Trigger Property="Tag" Value="DELETE"><Setter Property="Background" Value="#24F85149" /></Trigger>
            <Trigger Property="Tag" Value="CONNECT"><Setter Property="Background" Value="#22C9A0FF" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Response status, by class: 2xx quiet green, 3xx blue, 4xx amber, 5xx red, pending grey. -->
    <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="MinWidth" Value="40" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="ok"><Setter Property="Background" Value="#243FB950" /></Trigger>
            <Trigger Property="Tag" Value="redirect"><Setter Property="Background" Value="#2458A6FF" /></Trigger>
            <Trigger Property="Tag" Value="clientError"><Setter Property="Background" Value="#26D29922" /></Trigger>
            <Trigger Property="Tag" Value="serverError"><Setter Property="Background" Value="#26F85149" /></Trigger>
            <Trigger Property="Tag" Value="failed"><Setter Property="Background" Value="#26F85149" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillTextStrong" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Numbers: right-aligned and monospaced, so columns of them line up and stop jittering. -->
    <Style x:Key="NumericCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- How much of the capture one host accounts for: the list is sorted by it, this shows it. -->
    <Style x:Key="VolumeTrack" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="VolumeFill" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource BrandNeonBrush}" />
    </Style>

    <!-- ============================ Section headings ============================ -->

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionAccent" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource BrandNeonBrush}" />
    </Style>

    <!-- ============================ Toasts ============================

        Short-lived confirmations - copied, repeated, saved - in the corner of the window. They
        exist because the status line is on the wrong side of the screen from where the action
        happened, and because "did that work?" should not need looking for.
    -->
    <Style x:Key="Toast" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="22" ShadowDepth="5" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Stream turns ============================ -->

    <Style x:Key="TurnCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

</ResourceDictionary>
