<ui:FluentWindow x:Class="Loupe.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Loupe.App.Views"
                 xmlns:loc="clr-namespace:Loupe.App.Localization"
                 xmlns:conv="clr-namespace:Loupe.App.Converters"
                 Title="Loupe" Height="880" Width="1500"
                 MinWidth="880" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="{StaticResource LoupeMark}"
                 KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <conv:ResourceBrushConverter x:Key="ResourceBrush" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />

        <DataTemplate x:Key="LanguageItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,3">
                <Border Style="{StaticResource FlagSwatch}"
                        Background="{Binding FlagKey, Converter={StaticResource ResourceBrush}}" />
                <TextBlock Text="{Binding NativeName}" Margin="10,0,4,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowScrimBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The full lockup lives in the title bar, which is the one strip wide enough for a
            wordmark. It sits over the bar rather than inside it and is not hit-testable, so
            dragging the window still works right across the logo.
        -->
        <Grid Grid.Row="0" Height="56">
            <ui:TitleBar Title="" VerticalAlignment="Stretch" />
            <Image Source="{StaticResource LoupeLogo}" Height="40" Margin="16,0,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Loupe" />
        </Grid>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nav rail -->
            <Border Grid.Column="0" Width="108" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,8,0,0">
                        <!-- The logo is in the title bar; the rail is for navigation alone. -->

                        <RadioButton x:Name="PacketsNavButton" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     AutomationProperties.Name="{DynamicResource Nav_Packets}"
                                     Checked="OnPacketsNavChecked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Pulse24" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Packets}" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ProxyNavButton" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     AutomationProperties.Name="{DynamicResource Nav_Proxy}"
                                     Checked="OnProxyNavChecked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Proxy}" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SessionsNavButton" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     AutomationProperties.Name="{DynamicResource Nav_Sessions}"
                                     Checked="OnSessionsNavChecked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Bookmark24" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Sessions}" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SettingsNavButton" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     AutomationProperties.Name="{DynamicResource Nav_Settings}"
                                     Checked="OnSettingsNavChecked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Settings}" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Language: flag chip in the rail, full list in a popup so long names aren't clipped -->
                    <Grid Grid.Row="1" Margin="0,6,0,10">
                        <!-- Not hit-testable while the popup is open: otherwise the click that dismisses
                             the popup (StaysOpen=False) also lands on the toggle and reopens it -->
                        <ToggleButton x:Name="LanguageToggle" Style="{StaticResource FlagChip}"
                                      HorizontalAlignment="Center" ToolTip="{DynamicResource Nav_Language}"
                                      AutomationProperties.Name="{DynamicResource Nav_Language}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=LanguagePopup, Converter={StaticResource InverseBoolean}}">
                            <Border x:Name="CurrentFlag" Style="{StaticResource FlagSwatch}" />
                        </ToggleButton>

                        <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageToggle}"
                               Placement="Top" VerticalOffset="-8" HorizontalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=LanguageToggle, Mode=TwoWay}"
                               Closed="OnLanguagePopupClosed">
                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="6" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="4" Direction="270" />
                                </Border.Effect>
                                <ListBox x:Name="LanguageList" Background="Transparent" BorderThickness="0"
                                         ItemsSource="{x:Static loc:LocalizationService.AvailableLanguages}"
                                         ItemTemplate="{StaticResource LanguageItemTemplate}"
                                         SelectionChanged="OnLanguageSelectionChanged" />
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <!-- Content: the two pages cross-fade on nav change -->
            <Grid Grid.Column="2">
                <views:PacketCapturePage x:Name="PacketsPage" />
                <views:ProxyPage x:Name="ProxyPageControl" Visibility="Collapsed" Opacity="0" />
                <views:SessionsPage x:Name="SessionsPageControl" Visibility="Collapsed" Opacity="0" />
                <views:SettingsPage x:Name="SettingsPageControl" Visibility="Collapsed" Opacity="0" />

                <!--
                    Confirmations land here, next to where the action happened, rather than in
                    the status line at the far corner of the window. Not hit-testable: a toast
                    that swallows a click on the thing underneath it is worse than no toast.
                -->
                <ItemsControl x:Name="Toasts" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                              Margin="0,0,16,16" IsHitTestVisible="False" Panel.ZIndex="50">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Toast}">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Margin="0,0,9,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrandCyanBrush}" />
                                    <TextBlock Text="{Binding Message}" FontSize="12.5" MaxWidth="360"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
