<UserControl x:Class="Loupe.App.Views.ProxyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Loupe.App.Converters"
             xmlns:vm="clr-namespace:Loupe.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProxyViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="ExchangeRow" TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#1AF85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Top bar, read left to right: what the proxy listens on, the one button that starts
            it, then what you do to what it captured, then the system switch. Only the primary
            action carries colour; everything else is an icon in a segmented strip.
        -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{DynamicResource Proxy_Start}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                               Style="{StaticResource AppButton}" Command="{Binding StartProxyCommand}"
                               Height="36" Margin="0,0,10,0" FontWeight="SemiBold"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityInverse}}" />
                    <ui:Button Content="{DynamicResource Proxy_Stop}" Icon="{ui:SymbolIcon Stop24}" Appearance="Danger"
                               Style="{StaticResource AppButton}" Command="{Binding StopProxyCommand}"
                               Height="36" Margin="0,0,10,0" FontWeight="SemiBold"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{DynamicResource Proxy_Port}" Style="{StaticResource ToolbarLabel}" />
                    <ui:TextBox Width="72" Margin="0,0,10,0" VerticalAlignment="Center"
                                Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                    <CheckBox Content="{DynamicResource Proxy_Transparent}" IsChecked="{Binding TransparentEnabled}"
                              ToolTip="{DynamicResource Proxy_Transparent_Tip}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />
                    <ui:TextBox Width="72" Margin="0,0,10,0" VerticalAlignment="Center"
                                Text="{Binding TransparentPortText, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"
                                Visibility="{Binding TransparentEnabled, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{StaticResource ToolbarDivider}" />
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ToolbarStrip}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding SaveSessionCommand}"
                                    ToolTip="{DynamicResource Sessions_Save_Tip}"
                                    AutomationProperties.Name="{DynamicResource Sessions_Save}">
                                <ui:SymbolIcon Symbol="Bookmark24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ClearExchangesCommand}"
                                    ToolTip="{DynamicResource Proxy_Clear}"
                                    AutomationProperties.Name="{DynamicResource Proxy_Clear}">
                                <ui:SymbolIcon Symbol="Broom24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Certificate: install and remove share a slot, export sits beside it. -->
                    <Border Style="{StaticResource ToolbarStrip}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding InstallRootCertificateCommand}"
                                    ToolTip="{DynamicResource Proxy_InstallCert}"
                                    AutomationProperties.Name="{DynamicResource Proxy_InstallCert}"
                                    Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibilityInverse}}">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding UninstallRootCertificateCommand}"
                                    ToolTip="{DynamicResource Proxy_UninstallCert}"
                                    AutomationProperties.Name="{DynamicResource Proxy_UninstallCert}"
                                    Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="{StaticResource SuccessBrush}" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ExportRootCertificateCommand}"
                                    ToolTip="{DynamicResource Proxy_ExportCert}"
                                    AutomationProperties.Name="{DynamicResource Proxy_ExportCert}">
                                <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarStrip}">
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                      IsChecked="{Binding IsSystemProxyEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleSystemProxyCommand}"
                                      ToolTip="{DynamicResource Proxy_SystemProxy_Tip}"
                                      AutomationProperties.Name="{DynamicResource Proxy_SystemProxy}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wifi124" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Proxy_SystemProxy}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!--
            The three conditions, as buttons rather than a legend: each one does the step it
            names and goes green once it holds. "Why is nothing showing up here" is answered by
            looking, and fixed by clicking.
        -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource StepButton}" Tag="{Binding IsRunning}"
                            Command="{Binding StartProxyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="{DynamicResource Proxy_Step_Start}" Style="{StaticResource StepText}" />
                            <ui:SymbolIcon Symbol="Checkmark24" Style="{StaticResource StepCheck}"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StepButton}" Tag="{Binding IsCaInstalled}"
                            Command="{Binding InstallRootCertificateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="2" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="{DynamicResource Proxy_Step_Cert}" Style="{StaticResource StepText}" />
                            <ui:SymbolIcon Symbol="Checkmark24" Style="{StaticResource StepCheck}"
                                           Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StepButton}" Tag="{Binding IsSystemProxyEnabled}"
                            Command="{Binding ToggleSystemProxyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="3" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="{DynamicResource Proxy_Step_System}" Style="{StaticResource StepText}" />
                            <ui:SymbolIcon Symbol="Checkmark24" Style="{StaticResource StepCheck}"
                                           Visibility="{Binding IsSystemProxyEnabled, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="2,10,0,0" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Text="{DynamicResource Proxy_Banner}" TextWrapping="Wrap" FontSize="11.5" Margin="2,6,0,0"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Exchange list -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288" MinWidth="200" MaxWidth="460" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!--
                Domain sidebar. Reading a capture starts with "what was this app talking to",
                not "what happened at 12:04:31.882", so the domains come first and the requests
                hang underneath the one you pick.
            -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,10,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="6,0,4,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,7,0"
                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Proxy_Domains}" Style="{StaticResource PanelHeader}" />
                            <TextBlock Text="{Binding Domains.Count}" Style="{StaticResource PanelHeader}"
                                       Margin="7,0,0,0" Opacity="0.65" />
                        </StackPanel>

                        <ComboBox HorizontalAlignment="Right" MinWidth="118" FontSize="11.5"
                                  ItemsSource="{Binding DomainSortOptions}" SelectedItem="{Binding DomainSort}"
                                  DisplayMemberPath="Label"
                                  ToolTip="{DynamicResource Sort_Tip}"
                                  AutomationProperties.Name="{DynamicResource Sort_Tip}" />
                    </Grid>

                    <ui:TextBox Grid.Row="1" Margin="2,0,2,6"
                                PlaceholderText="{DynamicResource Domains_Search_Placeholder}"
                                Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                                Text="{Binding DomainSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Grid.Row="2" Style="{StaticResource FilterChip}" HorizontalAlignment="Left" Margin="2,0,2,8"
                            Visibility="{Binding HasHidden, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding HiddenSummary}" FontSize="12" MaxWidth="190"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding HiddenSummary}"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ChipCloseButton}" Command="{Binding ShowHiddenCommand}"
                                    ToolTip="{DynamicResource Ignore_ShowAll}"
                                    AutomationProperties.Name="{DynamicResource Ignore_ShowAll}" />
                        </StackPanel>
                    </Border>

                    <TreeView Grid.Row="3" x:Name="DomainTree" ContextMenuOpening="OnDomainTreeContextMenuOpening" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding Domains}"
                              SelectedItemChanged="OnDomainTreeSelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ContextMenu><ContextMenu /></TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <!--
                            Both templates are implicit (DataType-matched) rather than set via
                            ItemTemplate: an explicit ItemTemplate is applied at every level of
                            the tree, so the child requests would render with the domain's
                            template and show the host instead of the request.
                        -->
                        <TreeView.Resources>
                            <!-- Leaf: one request. Method and status carry the colour so a failure
                                 is visible without reading the row. -->
                            <DataTemplate DataType="{x:Type vm:HttpExchangeRowViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                        <!-- The sending app's icon: which program asked is half the story -->
                                        <Image Source="{Binding ClientIcon}" Width="14" Height="14" Margin="0,0,6,0"
                                               ToolTip="{Binding Client}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Background="{StaticResource SurfaceSunkenBrush}"
                                                CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Method}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="{Binding Url}" />

                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:DomainGroupViewModel}"
                                                      ItemsSource="{Binding Exchanges}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Tick several domains to compare them side by side -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,7,0"
                                              VerticalAlignment="Center"
                                              ToolTip="{DynamicResource Filter_TickToFilter}"
                                              AutomationProperties.Name="{Binding Host}" />

                                    <Border Grid.Column="1" Style="{StaticResource FaviconTile}" Margin="0,0,9,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource FaviconInitial}" />
                                            <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Host}" Style="{StaticResource HostName}"
                                               ToolTip="{Binding Host}" />

                                    <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <StackPanel Grid.Row="3" Style="{StaticResource EmptyState}"
                                Visibility="{Binding Domains.Count, Converter={StaticResource CountToVisibility}}">
                        <ui:SymbolIcon Symbol="Globe24" Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Text="{DynamicResource Proxy_Domains_EmptyState}" Style="{StaticResource EmptyStateText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="1">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox x:Name="SearchBox" Width="300" VerticalAlignment="Center"
                                    PlaceholderText="{DynamicResource Proxy_Search_Placeholder}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Searching bodies means decoding them, so it is asked for rather than
                             assumed - but it is the only way to find "which request carried this id". -->
                        <Border Style="{StaticResource ToolbarStrip}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding SearchBodies}"
                                              ToolTip="{DynamicResource Proxy_SearchBodies_Tip}"
                                              AutomationProperties.Name="{DynamicResource Proxy_SearchBodies}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Proxy_SearchBodies}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding ErrorsOnly}"
                                              ToolTip="{DynamicResource Proxy_ErrorsOnly_Tip}"
                                              AutomationProperties.Name="{DynamicResource Proxy_ErrorsOnly}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Proxy_ErrorsOnly}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource FilterChip}" HorizontalAlignment="Left" Margin="10,0,0,0"
                            Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Filter24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FilterScope}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="{Binding SelectedDomain, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                            <TextBlock Text="{Binding FilterSummary}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ChipCloseButton}" Command="{Binding ClearFilterCommand}"
                                    ToolTip="{DynamicResource Filter_Clear}"
                                    AutomationProperties.Name="{DynamicResource Filter_Clear}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DataGrid x:Name="ExchangeGrid" Grid.Row="1"
                          ContextMenuOpening="OnExchangeGridContextMenuOpening"
                          Background="Transparent" BorderThickness="0"
                          RowStyle="{StaticResource ExchangeRow}"
                          ItemsSource="{Binding Exchanges}"
                          SelectedItem="{Binding SelectedExchange}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="None" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource AppColumnHeader}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.ContextMenu><ContextMenu /></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Time}" Binding="{Binding Time}" Width="96" />
                        <DataGridTemplateColumn Header="{DynamicResource Proxy_Col_Client}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <Image Source="{Binding ClientIcon}" Width="14" Height="14" Margin="0,1,6,0"
                                               VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Client}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Client}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Proxy_Col_Method}" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Border Style="{StaticResource MethodPill}" Tag="{Binding Method}">
                                            <TextBlock Text="{Binding Method}" Style="{StaticResource PillTextStrong}" />
                                        </Border>
                                        <!-- A replay is our own doing, not something the machine did;
                                             the list says so rather than letting it pass for traffic. -->
                                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="13" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrandCyanBrush}"
                                                       ToolTip="{DynamicResource Proxy_ReplayBadge}"
                                                       Visibility="{Binding IsReplay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Scheme}" Binding="{Binding Scheme}" Width="78" />
                        <DataGridTemplateColumn Header="{DynamicResource Proxy_Col_Host}" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <Image Source="{Binding Favicon}" Width="14" Height="14" Margin="0,1,7,0"
                                               VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Host}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Path}" Binding="{Binding Path}" Width="*" />
                        <DataGridTemplateColumn Header="{DynamicResource Proxy_Col_Status}" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}" Tag="{Binding StatusKind}" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource PillTextStrong}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Detail}" Binding="{Binding StatusDetail}" Width="140" />
                        <DataGridTemplateColumn Header="{DynamicResource Proxy_Col_Size}" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource NumericCell}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Proxy_Col_Duration}" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Duration}" Style="{StaticResource NumericCell}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                            Visibility="{Binding Exchanges.Count, Converter={StaticResource CountToVisibility}}">
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Text="{DynamicResource Proxy_EmptyState}" Style="{StaticResource EmptyStateText}" />
                </StackPanel>
            </Grid>
            </Border>
        </Grid>

        <!-- Request/response detail: appears with a request, and takes no room without one. -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="6" Height="300"
                Visibility="{Binding SelectedExchange, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
            <Grid>
                <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="{DynamicResource Proxy_Tab_Request}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="84" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource SurfaceSunkenBrush}">
                            <TextBox Text="{Binding SelectedExchange.RequestHeadersText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <TextBox Text="{Binding SelectedExchange.RequestBodyText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Proxy_Tab_Response}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="84" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource SurfaceSunkenBrush}">
                            <TextBox Text="{Binding SelectedExchange.ResponseHeadersText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <TextBox Text="{Binding SelectedExchange.ResponseBodyText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
