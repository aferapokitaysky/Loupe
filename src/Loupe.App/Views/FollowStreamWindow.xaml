<ui:FluentWindow x:Class="Loupe.App.Views.FollowStreamWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Loupe.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:FollowStreamViewModel}"
                 Height="720" Width="1040" MinWidth="560" MinHeight="380"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="{StaticResource LoupeMark}">

    <Grid Background="{StaticResource WindowScrimBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="10,0,10,8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarStrip}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding RefreshCommand}"
                                ToolTip="{DynamicResource Follow_Refresh}"
                                AutomationProperties.Name="{DynamicResource Follow_Refresh}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                        </Button>
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding AsHex}"
                                      ToolTip="{DynamicResource Follow_Hex_Tip}"
                                      AutomationProperties.Name="{DynamicResource Follow_Hex}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="NumberSymbol24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Follow_Hex}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Follow_Note}" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="90" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="90" />
            </Grid.RowDefinitions>

            <!-- Sent by the side whose packet was selected, then what came back. -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,9,8,7">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrandCyanBrush}" />
                            <TextBlock Text="{Binding OutgoingLabel}" Style="{StaticResource PanelHeader}" />
                            <TextBlock Text="{Binding OutgoingSummary}" Style="{StaticResource PanelHeader}"
                                       Margin="10,0,0,0" Opacity="0.65" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding CopyCommand}"
                                    CommandParameter="outgoing" ToolTip="{DynamicResource Follow_Copy}"
                                    AutomationProperties.Name="{DynamicResource Follow_Copy}">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding SaveCommand}"
                                    CommandParameter="outgoing" ToolTip="{DynamicResource Follow_Save}"
                                    AutomationProperties.Name="{DynamicResource Follow_Save}">
                                <ui:SymbolIcon Symbol="Save24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceSunkenBrush}">
                        <TextBox Text="{Binding OutgoingText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="8" Background="Transparent" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,9,8,7">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrandNeonBrush}" />
                            <TextBlock Text="{Binding IncomingLabel}" Style="{StaticResource PanelHeader}" />
                            <TextBlock Text="{Binding IncomingSummary}" Style="{StaticResource PanelHeader}"
                                       Margin="10,0,0,0" Opacity="0.65" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding CopyCommand}"
                                    CommandParameter="incoming" ToolTip="{DynamicResource Follow_Copy}"
                                    AutomationProperties.Name="{DynamicResource Follow_Copy}">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding SaveCommand}"
                                    CommandParameter="incoming" ToolTip="{DynamicResource Follow_Save}"
                                    AutomationProperties.Name="{DynamicResource Follow_Save}">
                                <ui:SymbolIcon Symbol="Save24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceSunkenBrush}">
                        <TextBox Text="{Binding IncomingText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
