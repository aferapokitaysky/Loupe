<ui:FluentWindow x:Class="Loupe.App.Views.FollowStreamWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:Loupe.App.Converters"
                 xmlns:vm="clr-namespace:Loupe.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:FollowStreamViewModel}"
                 Height="760" Width="1100" MinWidth="620" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="{StaticResource LoupeMark}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:ResourceBrushConverter x:Key="ResourceBrush" />
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource WindowScrimBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <!--
            The four ways to read one conversation. "Dialogue" is first because it is the one
            that answers "what happened here": turns in the order they were taken. The others
            exist for reading one side end to end, which interleaving makes impossible.
        -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="10,0,10,8" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource ToolbarStrip}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsDialogue}"
                                          AutomationProperties.Name="{DynamicResource Follow_Mode_Dialogue}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Follow_Mode_Dialogue}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsBoth}"
                                          AutomationProperties.Name="{DynamicResource Follow_Mode_Both}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="SplitVertical24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Follow_Mode_Both}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsSentOnly}"
                                          AutomationProperties.Name="{DynamicResource Follow_Mode_Sent}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="15" Margin="0,0,6,0"
                                                   Foreground="{StaticResource BrandCyanBrush}" />
                                    <TextBlock Text="{DynamicResource Follow_Mode_Sent}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsReceivedOnly}"
                                          AutomationProperties.Name="{DynamicResource Follow_Mode_Received}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Follow_Mode_Received}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarStrip}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding AsHex}"
                                          ToolTip="{DynamicResource Follow_Hex_Tip}"
                                          AutomationProperties.Name="{DynamicResource Follow_Hex}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="NumberSymbol24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Follow_Hex}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding RefreshCommand}"
                                    ToolTip="{DynamicResource Follow_Refresh}"
                                    AutomationProperties.Name="{DynamicResource Follow_Refresh}">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding CopyCommand}"
                                    CommandParameter="dialogue" ToolTip="{DynamicResource Follow_Copy}"
                                    AutomationProperties.Name="{DynamicResource Follow_Copy}">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding TurnsSummary}" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="12,0,2,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="10,0,10,10">

            <!-- Dialogue: one card per turn, coloured and arrowed by direction. -->
            <Border Style="{StaticResource Card}" Padding="10"
                    Visibility="{Binding IsDialogue, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Turns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TurnCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="9,0,0,9"
                                                    Background="{Binding AccentKey, Converter={StaticResource ResourceBrush}}" />

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,0">
                                                    <TextBlock Text="{Binding Arrow}" FontSize="13" FontWeight="Bold"
                                                               Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{Binding AccentKey, Converter={StaticResource ResourceBrush}}" />
                                                    <TextBlock Text="{Binding Endpoint}" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Time}" FontSize="11" Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding Size}" FontSize="11" Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>

                                                <TextBox Grid.Row="1" Text="{Binding Text, Mode=OneWay}"
                                                         Style="{StaticResource MonoText}" Margin="0,2,0,4"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         HorizontalScrollBarVisibility="Auto" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding Turns.Count, Converter={StaticResource CountToVisibility}}">
                        <ui:SymbolIcon Symbol="ArrowSwap24" Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Text="{DynamicResource Follow_Empty}" Style="{StaticResource EmptyStateText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- One side, or both, reassembled whole. -->
            <Grid Visibility="{Binding IsDialogue, Converter={StaticResource BoolToVisibilityInverse}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1"
                        Visibility="{Binding ShowOutgoingPane, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,9,8,7">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionAccent}" Background="{StaticResource BrandCyanBrush}" />
                                <TextBlock Text="{Binding OutgoingLabel}" Style="{StaticResource SectionTitle}" FontSize="12.5" />
                                <TextBlock Text="{Binding OutgoingSummary}" Style="{StaticResource PanelHeader}" Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding CopyCommand}"
                                        CommandParameter="outgoing" ToolTip="{DynamicResource Follow_Copy}"
                                        AutomationProperties.Name="{DynamicResource Follow_Copy}">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding SaveCommand}"
                                        CommandParameter="outgoing" ToolTip="{DynamicResource Follow_Save}"
                                        AutomationProperties.Name="{DynamicResource Follow_Save}">
                                    <ui:SymbolIcon Symbol="Save24" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Background="{StaticResource SurfaceSunkenBrush}">
                            <TextBox Text="{Binding OutgoingText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="8" Background="Transparent"
                              Visibility="{Binding IsBoth, Converter={StaticResource BoolToVisibility}}" />

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1"
                        Visibility="{Binding ShowIncomingPane, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,9,8,7">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionAccent}" />
                                <TextBlock Text="{Binding IncomingLabel}" Style="{StaticResource SectionTitle}" FontSize="12.5" />
                                <TextBlock Text="{Binding IncomingSummary}" Style="{StaticResource PanelHeader}" Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding CopyCommand}"
                                        CommandParameter="incoming" ToolTip="{DynamicResource Follow_Copy}"
                                        AutomationProperties.Name="{DynamicResource Follow_Copy}">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding SaveCommand}"
                                        CommandParameter="incoming" ToolTip="{DynamicResource Follow_Save}"
                                        AutomationProperties.Name="{DynamicResource Follow_Save}">
                                    <ui:SymbolIcon Symbol="Save24" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Background="{StaticResource SurfaceSunkenBrush}">
                            <TextBox Text="{Binding IncomingText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Said once, at the bottom, where it does not interrupt anything. -->
            <TextBlock Text="{DynamicResource Follow_Truncated}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource WarnBrush}"
                       Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
