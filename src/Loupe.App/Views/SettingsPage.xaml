<UserControl x:Class="Loupe.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Loupe.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingsNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ShortcutKey" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <WrapPanel Orientation="Horizontal" ItemHeight="34">
                <ui:SymbolIcon Symbol="Settings24" FontSize="15" Margin="2,0,10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBlock Text="{DynamicResource Nav_Settings}" Style="{StaticResource ToolbarLabel}" />
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <!-- Privacy first: it is the setting with consequences outside this machine. -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set_Privacy}" Style="{StaticResource SettingsGroupTitle}" />

                        <CheckBox Content="{DynamicResource Set_Favicons}" IsChecked="{Binding FetchFavicons}" />
                        <TextBlock Text="{DynamicResource Set_Favicons_Note}" Style="{StaticResource SettingsNote}" />

                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Set_Hidden}" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HiddenRulesText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="{DynamicResource Ignore_ShowAll}"
                                           Icon="{ui:SymbolIcon Eye24}" Style="{StaticResource AppButton}"
                                           VerticalAlignment="Center" Command="{Binding ResetHiddenCommand}"
                                           IsEnabled="{Binding HasHiddenRules}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav_Packets}" Style="{StaticResource SettingsGroupTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Set_Rows}" VerticalAlignment="Center" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <ComboBox MinWidth="150" ItemsSource="{Binding PacketLimits}"
                                      SelectedItem="{Binding MaxPackets}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{DynamicResource Set_Rows}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Set_Rows_Note}" Style="{StaticResource SettingsNote}" />

                        <CheckBox Content="{DynamicResource Set_Autostart}" IsChecked="{Binding StartCaptureOnLaunch}"
                                  Margin="0,14,0,0" />
                        <TextBlock Text="{DynamicResource Set_Autostart_Note}" Style="{StaticResource SettingsNote}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav_Proxy}" Style="{StaticResource SettingsGroupTitle}" />
                        <TextBlock Text="{Binding CaName}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Proxy_CaLabel}" FontSize="12"
                                   Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CaThumbprint}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Set_Ca_Note}" Style="{StaticResource SettingsNote}" />

                        <!-- Only worth offering when the certificate still says the old name, or
                             when someone deliberately wants a fresh key. -->
                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                                Visibility="{Binding CaHasLegacyName, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Set_Ca_LegacyName}" Style="{StaticResource SettingsNote}"
                                       Margin="0" Foreground="{StaticResource WarnBrush}" />
                        </Border>

                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="8" Padding="12,10" Margin="0,8,0,0"
                                Visibility="{Binding CaIsUnrestricted, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Set_Ca_Unrestricted}" Style="{StaticResource SettingsNote}"
                                       Margin="0" Foreground="{StaticResource WarnBrush}" />
                        </Border>

                        <ui:Button Content="{DynamicResource Set_Ca_Regenerate}" Icon="{ui:SymbolIcon ShieldKeyhole24}"
                                   Style="{StaticResource AppButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                   Command="{Binding RegenerateCertificateCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set_Data}" Style="{StaticResource SettingsGroupTitle}" />

                        <TextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource SettingsNote}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Content="{DynamicResource Set_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}"
                                       Style="{StaticResource AppButton}" Command="{Binding OpenDataFolderCommand}"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Set_ClearIcons}" Icon="{ui:SymbolIcon Broom24}"
                                       Style="{StaticResource AppButton}" Command="{Binding ClearFaviconCacheCommand}"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Set_Recount}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Style="{StaticResource AppButton}" Command="{Binding RefreshUsageCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set_Shortcuts}" Style="{StaticResource SettingsGroupTitle}" />

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + S" FontSize="11.5" /></Border>
                                <TextBlock Text="{DynamicResource Key_Save}" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + F" FontSize="11.5" /></Border>
                                <TextBlock Text="{DynamicResource Key_Search}" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + L" FontSize="11.5" /></Border>
                                <TextBlock Text="{DynamicResource Key_Clear}" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + R" FontSize="11.5" /></Border>
                                <TextBlock Text="{DynamicResource Key_Replay}" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="F5" FontSize="11.5" /></Border>
                                <TextBlock Text="{DynamicResource Key_Refresh}" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ShortcutKey}"><TextBlock Text="F1" FontSize="11.5" /></Border>
                                <TextBlock Text="{DynamicResource Key_Settings}" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set_About}" Style="{StaticResource SettingsGroupTitle}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource Set_About_Note}" Style="{StaticResource SettingsNote}" />
                        <ui:Button Content="github.com/aferapokitaysky/Loupe" Icon="{ui:SymbolIcon Open24}"
                                   Style="{StaticResource AppButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                   Command="{Binding OpenProjectCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
