<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NetSniffer.Capture</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetSniffer.Core\NetSniffer.Core.csproj" />
  </ItemGroup>

  <!-- Pulls in the native capture engine built by native\NetSniffer.Native\NetSniffer.Native.vcxproj
       (build the .sln, not just this .csproj, so the native DLL exists) -->
  <ItemGroup>
    <None Include="..\..\native\bin\x64\$(Configuration)\NetSniffer.Native.dll"
          Condition="Exists('..\..\native\bin\x64\$(Configuration)\NetSniffer.Native.dll')">
      <Link>NetSniffer.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
