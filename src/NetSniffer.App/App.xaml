<Application x:Class="NetSniffer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Styles/GlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="StreamBrushClient" Color="#569CD6" />
            <SolidColorBrush x:Key="StreamBrushServer" Color="#4EC9B0" />

            <!-- Per-protocol row accents: translucent glass tints, in the spirit of Wireshark's coloring rules -->
            <SolidColorBrush x:Key="ProtocolColorTls" Color="#3322C55E" />
            <SolidColorBrush x:Key="ProtocolColorHttp" Color="#33F59E0B" />
            <SolidColorBrush x:Key="ProtocolColorDns" Color="#333B82F6" />
            <SolidColorBrush x:Key="ProtocolColorTcp" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ProtocolColorUdp" Color="#2622D3EE" />
            <SolidColorBrush x:Key="ProtocolColorArp" Color="#337C6CFF" />
            <SolidColorBrush x:Key="ProtocolColorIcmp" Color="#33EF4444" />
            <SolidColorBrush x:Key="ProtocolColorDefault" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
