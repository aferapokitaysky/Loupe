<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Country flags drawn as vectors. Windows' emoji font has never rendered
        regional-indicator flag sequences (🇬🇧 shows up as the letters "GB"),
        so the emoji shortcut isn't an option here - these are plain geometry
        on a 60x40 canvas, simplified where detail would be invisible at the
        ~20px the language picker renders them at.
    -->

    <DrawingBrush x:Key="Flag_GB" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#012169" Geometry="M0,0 H60 V40 H0 Z" />
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 L60,40 M60,0 L0,40">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="11" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L60,40 M60,0 L0,40">
                    <GeometryDrawing.Pen><Pen Brush="#C8102E" Thickness="4" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M24,0 H36 V40 H24 Z M0,14 H60 V26 H0 Z" />
                <GeometryDrawing Brush="#C8102E" Geometry="M26.5,0 H33.5 V40 H26.5 Z M0,16.5 H60 V23.5 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_RU" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H60 V13.33 H0 Z" />
                <GeometryDrawing Brush="#0039A6" Geometry="M0,13.33 H60 V26.67 H0 Z" />
                <GeometryDrawing Brush="#D52B1E" Geometry="M0,26.67 H60 V40 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_UA" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0057B7" Geometry="M0,0 H60 V20 H0 Z" />
                <GeometryDrawing Brush="#FFD700" Geometry="M0,20 H60 V40 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_ES" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#AA151B" Geometry="M0,0 H60 V10 H0 Z M0,30 H60 V40 H0 Z" />
                <GeometryDrawing Brush="#F1BF00" Geometry="M0,10 H60 V30 H0 Z" />
                <GeometryDrawing Brush="#9C1B1F" Geometry="M15,16.5 H20 V23.5 Q17.5,25.5 15,23.5 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_DE" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#000000" Geometry="M0,0 H60 V13.33 H0 Z" />
                <GeometryDrawing Brush="#DD0000" Geometry="M0,13.33 H60 V26.67 H0 Z" />
                <GeometryDrawing Brush="#FFCE00" Geometry="M0,26.67 H60 V40 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_FR" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#002395" Geometry="M0,0 H20 V40 H0 Z" />
                <GeometryDrawing Brush="#FFFFFF" Geometry="M20,0 H40 V40 H20 Z" />
                <GeometryDrawing Brush="#ED2939" Geometry="M40,0 H60 V40 H40 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_PT" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#006600" Geometry="M0,0 H24 V40 H0 Z" />
                <GeometryDrawing Brush="#FF0000" Geometry="M24,0 H60 V40 H24 Z" />
                <GeometryDrawing Brush="#FFE900">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="24,20" RadiusX="7.5" RadiusY="7.5" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF0000">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="24,20" RadiusX="4.6" RadiusY="4.6" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="24,20" RadiusX="2.2" RadiusY="2.2" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_IT" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#009246" Geometry="M0,0 H20 V40 H0 Z" />
                <GeometryDrawing Brush="#F1F2F1" Geometry="M20,0 H40 V40 H20 Z" />
                <GeometryDrawing Brush="#CE2B37" Geometry="M40,0 H60 V40 H40 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_CN" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#EE1C25" Geometry="M0,0 H60 V40 H0 Z" />
                <GeometryDrawing Brush="#FFDE00"
                                 Geometry="M10,4 L11.35,8.15 L15.71,8.15 L12.18,10.71 L13.53,14.85 L10,12.29 L6.47,14.85 L7.82,10.71 L4.29,8.15 L8.65,8.15 Z" />
                <GeometryDrawing Brush="#FFDE00">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="20,4" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="24,8" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="24,13.5" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="20,17.5" RadiusX="1.6" RadiusY="1.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_JP" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H60 V40 H0 Z" />
                <GeometryDrawing Brush="#BC002D">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="30,20" RadiusX="12" RadiusY="12" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_TR" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#E30A17" Geometry="M0,0 H60 V40 H0 Z" />
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="22,20" RadiusX="9" RadiusY="9" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E30A17">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="25.5,20" RadiusX="7.2" RadiusY="7.2" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF"
                                 Geometry="M37,15.5 L38.01,18.61 L41.28,18.61 L38.63,20.53 L39.65,23.64 L37,21.72 L34.35,23.64 L35.37,20.53 L32.72,18.61 L35.99,18.61 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Flag_PL" Stretch="Fill" Viewbox="0,0,60,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H60 V20 H0 Z" />
                <GeometryDrawing Brush="#DC143C" Geometry="M0,20 H60 V40 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
