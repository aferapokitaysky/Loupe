<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        "Liquid glass" design tokens: a cool graphite palette, translucent
        frosted-glass surfaces layered over the window's Mica backdrop, and a
        soft violet-blue accent. Everything below is additive on top of
        WPF-UI's own Fluent styles (BasedOn where it touches a ui: control) so
        their control templates/behavior stay intact - this only adds color,
        depth and motion.
    -->

    <!-- Palette -->
    <Color x:Key="GlassAccentColor">#7C6CFF</Color>
    <Color x:Key="GlassAccentBrightColor">#9C8CFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GlassAccentColor}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource GlassAccentBrightColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C6CFF" />

    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#8C1E1E26" />
    <SolidColorBrush x:Key="GlassSurfaceHoverBrush" Color="#A62A2A34" />
    <SolidColorBrush x:Key="GlassSurfaceSunkenBrush" Color="#661A1A20" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderStrongBrush" Color="#40FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ABABB8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E7A" />

    <SolidColorBrush x:Key="WindowScrimTopBrush" Color="#E01A1A20" />
    <SolidColorBrush x:Key="WindowScrimBottomBrush" Color="#F00C0C10" />

    <LinearGradientBrush x:Key="WindowScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E01A1A20" />
        <GradientStop Offset="1" Color="#F00C0C10" />
    </LinearGradientBrush>

    <!-- Soft elevation shadow used by every glass surface -->
    <DropShadowEffect x:Key="GlassShadow" Color="Black" Opacity="0.38" BlurRadius="28" ShadowDepth="8" Direction="270" RenderingBias="Performance" />
    <DropShadowEffect x:Key="GlassShadowSoft" Color="Black" Opacity="0.22" BlurRadius="16" ShadowDepth="3" Direction="270" RenderingBias="Performance" />

    <!-- A frosted card: use as a wrapping Border around any panel -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect" Value="{StaticResource GlassShadowSoft}" />
    </Style>

    <Style x:Key="GlassCardFlat" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="CornerRadius" Value="14,14,0,0" />
    </Style>

    <!-- Buttons: additive hover/press "liquid" scale + glow on top of WPF-UI's own Fluent look -->
    <Style x:Key="LiquidButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.035" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.035" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.965" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.965" Duration="0:0:0.08" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.035" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.035" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Nav rail toggle: glass highlight cross-fades in on selection, gentle hover tint -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="0,14" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="HoverLayer" CornerRadius="10" Background="{StaticResource GlassSurfaceHoverBrush}" Opacity="0" />
                        <Border x:Name="SelectedLayer" CornerRadius="10" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#4D7C6CFF" />
                                    <GradientStop Offset="1" Color="#264FC3F7" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlassAccentBrightColor}" Opacity="0.55" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                        </Border>
                        <Border x:Name="AccentBar" Width="3" CornerRadius="2" Margin="2,8"
                                HorizontalAlignment="Left" Background="{StaticResource AccentBrightBrush}" Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon x:Name="Icon" Symbol="{TemplateBinding Tag}" FontSize="20"
                                               Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid row: smooth hover/selection tint instead of a hard color snap -->
    <Style x:Key="GlassDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassSurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A slow, endless opacity breathe - used behind empty-state icons for a bit of "liquid" life -->
    <Storyboard x:Key="BreatheStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.8" Duration="0:0:1.8">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Style x:Key="EmptyStateIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource BreatheStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>
