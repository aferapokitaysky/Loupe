<ui:FluentWindow x:Class="NetSniffer.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:NetSniffer.App.ViewModels"
                 xmlns:conv="clr-namespace:NetSniffer.App.Converters"
                 Title="NetSniffer" Height="820" Width="1360"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Window.Resources>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ProtocolColorConverter x:Key="ProtocolColorConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NetSniffer" />

        <!-- Toolbar -->
        <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Adapter:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="320" Margin="0,0,12,0"
                          ItemsSource="{Binding Adapters}"
                          SelectedItem="{Binding SelectedAdapter}"
                          DisplayMemberPath="Description"
                          IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolean}}" />

                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Command="{Binding RefreshAdaptersCommand}" Margin="0,0,12,0" />

                <TextBlock Text="Filter (BPF):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ui:TextBox Width="260" Margin="0,0,12,0" PlaceholderText="e.g. tcp port 443"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Content="Start" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                           Command="{Binding StartCaptureCommand}"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityInverse}}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Appearance="Danger"
                           Command="{Binding StopCaptureCommand}"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,8,0" />

                <ui:Button Content="Clear" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearPacketsCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Open .pcap" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenCaptureCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Save .pcap" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCaptureCommand}" Margin="0,0,8,0" />

                <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Packet list + details -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="PacketGrid" Grid.Row="0"
                      ItemsSource="{Binding Packets}"
                      SelectedItem="{Binding SelectedPacket}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="70" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="180" />
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="70" />
                    <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding ColorKey, Converter={StaticResource ResourceKey=ProtocolColorConverter}}" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="4" Background="Transparent" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TreeView Grid.Column="0" x:Name="DetailsTree"
                          ItemsSource="{Binding SelectedPacket.Packet.Layers}"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Fields}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Value, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding SelectedPacket.HexDump, Mode=OneWay}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             TextWrapping="NoWrap" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="10,6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" />
                <TextBlock Text="{Binding TotalPackets, StringFormat='  |  Packets: {0}'}" />
                <TextBlock Text="{Binding TotalBytes, StringFormat='  |  Bytes: {0:N0}'}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
