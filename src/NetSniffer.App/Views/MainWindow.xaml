<ui:FluentWindow x:Class="NetSniffer.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NetSniffer.App.Views"
                 xmlns:loc="clr-namespace:NetSniffer.App.Localization"
                 Title="NetSniffer" Height="860" Width="1440"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid Background="{DynamicResource WindowScrimBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NetSniffer" />

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nav rail -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                        <RadioButton x:Name="PacketsNavButton" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Tag="Wifi124" Content="{DynamicResource Nav_Packets}" Checked="OnPacketsNavChecked" />
                        <RadioButton x:Name="ProxyNavButton" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Tag="ShieldCheckmark24" Content="{DynamicResource Nav_Proxy}" Checked="OnProxyNavChecked" />
                    </StackPanel>

                    <ComboBox x:Name="LanguageComboBox" Grid.Row="1" Margin="8,4,8,12"
                              ToolTip="{DynamicResource Nav_Language}"
                              ItemsSource="{x:Static loc:LocalizationService.AvailableLanguages}"
                              DisplayMemberPath="Flag"
                              SelectionChanged="OnLanguageSelectionChanged" />
                </Grid>
            </Border>

            <!-- Content: PacketsPage/ProxyPageControl cross-fade between each other on nav change -->
            <Grid Grid.Column="2">
                <views:PacketCapturePage x:Name="PacketsPage" />
                <views:ProxyPage x:Name="ProxyPageControl" Visibility="Collapsed" Opacity="0" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
