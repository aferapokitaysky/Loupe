<UserControl x:Class="NetSniffer.App.Views.PacketCapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NetSniffer.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:vm="clr-namespace:NetSniffer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ProtocolColorConverter x:Key="ProtocolColorConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

        <Style x:Key="PacketRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource GlassDataGridRowStyle}">
            <Setter Property="Background" Value="{Binding ColorKey, Converter={StaticResource ProtocolColorConverter}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Pkt_Adapter}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="320" Margin="0,0,12,0"
                          ItemsSource="{Binding Adapters}"
                          SelectedItem="{Binding SelectedAdapter}"
                          DisplayMemberPath="Description"
                          IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolean}}" />

                <ui:Button Content="{DynamicResource Pkt_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding RefreshAdaptersCommand}" Margin="0,0,12,0" />

                <ui:Button Content="{DynamicResource Pkt_InstallNpcap}" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Style="{StaticResource LiquidButtonStyle}"
                           Appearance="Primary" Command="{Binding InstallNpcapCommand}"
                           Visibility="{Binding IsCaptureEngineAvailable, Converter={StaticResource BoolToVisibilityInverse}}"
                           Margin="0,0,12,0" />

                <TextBlock Text="{DynamicResource Pkt_Filter}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ui:TextBox Width="260" Margin="0,0,12,0" PlaceholderText="{DynamicResource Pkt_FilterPlaceholder}"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Content="{DynamicResource Pkt_Start}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                           Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding StartCaptureCommand}"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityInverse}}"
                           Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Pkt_Stop}" Icon="{ui:SymbolIcon Stop24}" Appearance="Danger"
                           Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding StopCaptureCommand}"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,8,0" />

                <ui:Button Content="{DynamicResource Pkt_Clear}" Icon="{ui:SymbolIcon Broom24}" Style="{StaticResource LiquidButtonStyle}" Command="{Binding ClearPacketsCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Pkt_OpenPcap}" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource LiquidButtonStyle}" Command="{Binding OpenCaptureCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Pkt_SavePcap}" Icon="{ui:SymbolIcon Save24}" Style="{StaticResource LiquidButtonStyle}" Command="{Binding SaveCaptureCommand}" Margin="0,0,8,0" />

                <CheckBox Content="{DynamicResource Pkt_AutoScroll}" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Packet list -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="1">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="PacketGrid" Grid.Row="0"
                          Background="Transparent" RowStyle="{StaticResource PacketRowStyle}"
                          ItemsSource="{Binding Packets}"
                          SelectedItem="{Binding SelectedPacket}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_No}" Binding="{Binding Number}" Width="70" />
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_Time}" Binding="{Binding Time}" Width="110" />
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_Source}" Binding="{Binding Source}" Width="180" />
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_Destination}" Binding="{Binding Destination}" Width="180" />
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_Protocol}" Binding="{Binding Protocol}" Width="80" />
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_Length}" Binding="{Binding Length}" Width="70" />
                        <DataGridTextColumn Header="{DynamicResource Pkt_Col_Info}" Binding="{Binding Info}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Packets.Count, Converter={StaticResource CountToVisibility}}"
                            IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="Wifi124" Style="{StaticResource EmptyStateIconStyle}" />
                    <TextBlock Text="{DynamicResource Pkt_EmptyState}" Style="{StaticResource EmptyStateTextStyle}" />
                </StackPanel>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="4" Background="Transparent" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TreeView Grid.Column="0" x:Name="DetailsTree"
                              ItemsSource="{Binding SelectedPacket.Packet.Layers}"
                              Background="{StaticResource GlassSurfaceSunkenBrush}" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Fields}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Value, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="{StaticResource GlassSurfaceSunkenBrush}">
                        <TextBox Text="{Binding SelectedPacket.HexDump, Mode=OneWay}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="14,8" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding PacketsCountText}" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding BytesCountText}" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
