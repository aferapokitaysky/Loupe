<UserControl x:Class="NetSniffer.App.Views.SessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NetSniffer.App.Converters"
             xmlns:vm="clr-namespace:NetSniffer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SessionsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <WrapPanel Orientation="Horizontal" ItemHeight="34">
                <ui:SymbolIcon Symbol="Bookmark24" FontSize="15" Margin="2,0,10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBlock Text="{DynamicResource Sessions_Title}" Style="{StaticResource ToolbarLabel}" Margin="0,0,14,0" />

                <ui:Button Content="{DynamicResource Sessions_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Style="{StaticResource AppButton}" Command="{Binding RefreshCommand}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SessionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Margin="0,0,14,0"
                                                Background="{StaticResource SurfaceSunkenBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <!-- Packets or requests: the icon says which page it opens into -->
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Pulse24" FontSize="18" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding HasPackets, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="18" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding HasPackets, Converter={StaticResource BoolToVisibilityInverse}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityInverse}}" />

                                            <!-- Rename in place: Enter commits, Escape cancels -->
                                            <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                        MaxWidth="360" HorizontalAlignment="Left"
                                                        KeyDown="OnRenameKeyDown" Loaded="OnRenameBoxLoaded"
                                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />

                                            <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Created, Mode=OneWay}" />
                                                <Run Text="{Binding Source, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="{DynamicResource Sessions_Open}" Icon="{ui:SymbolIcon Open24}"
                                                       Style="{StaticResource AppButton}" Appearance="Primary"
                                                       Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Icon="{ui:SymbolIcon Edit24}" Style="{StaticResource AppButton}"
                                                       ToolTip="{DynamicResource Sessions_Rename}"
                                                       AutomationProperties.Name="{DynamicResource Sessions_Rename}"
                                                       Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource AppButton}"
                                                       ToolTip="{DynamicResource Sessions_Reveal}"
                                                       AutomationProperties.Name="{DynamicResource Sessions_Reveal}"
                                                       Command="{Binding DataContext.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource AppButton}"
                                                       Appearance="Danger" Margin="6,0,0,0"
                                                       ToolTip="{DynamicResource Sessions_Delete}"
                                                       AutomationProperties.Name="{DynamicResource Sessions_Delete}"
                                                       Click="OnDeleteClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Style="{StaticResource EmptyState}"
                            Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibility}}">
                    <ui:SymbolIcon Symbol="Bookmark24" Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Text="{DynamicResource Sessions_EmptyState}" Style="{StaticResource EmptyStateText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,7">
            <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
