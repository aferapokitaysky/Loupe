<UserControl x:Class="NetSniffer.App.Views.ProxyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NetSniffer.App.Converters"
             xmlns:vm="clr-namespace:NetSniffer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProxyViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="ExchangeRow" TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#1AF85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: wraps instead of clipping -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <WrapPanel Orientation="Horizontal" ItemHeight="34">
                <TextBlock Text="{DynamicResource Proxy_Port}" Style="{StaticResource ToolbarLabel}" />
                <ui:TextBox Width="76" Margin="0,0,10,0" VerticalAlignment="Center"
                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                <ui:Button Content="{DynamicResource Proxy_Start}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                           Style="{StaticResource AppButton}" Command="{Binding StartProxyCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityInverse}}" />
                <ui:Button Content="{DynamicResource Proxy_Stop}" Icon="{ui:SymbolIcon Stop24}" Appearance="Danger"
                           Style="{StaticResource AppButton}" Command="{Binding StopProxyCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                <ui:Button Content="{DynamicResource Proxy_Clear}" Icon="{ui:SymbolIcon Broom24}"
                           Style="{StaticResource AppButton}" Command="{Binding ClearExchangesCommand}" Margin="0,0,14,0" />

                <ui:Button Content="{DynamicResource Proxy_InstallCert}" Icon="{ui:SymbolIcon ShieldCheckmark24}"
                           Style="{StaticResource AppButton}" Command="{Binding InstallRootCertificateCommand}"
                           Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibilityInverse}}" />
                <ui:Button Content="{DynamicResource Proxy_UninstallCert}" Icon="{ui:SymbolIcon ShieldError24}"
                           Style="{StaticResource AppButton}" Command="{Binding UninstallRootCertificateCommand}"
                           Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="{DynamicResource Proxy_ExportCert}" Icon="{ui:SymbolIcon ArrowExportUp24}"
                           Style="{StaticResource AppButton}" Command="{Binding ExportRootCertificateCommand}" Margin="0,0,14,0" />

                <ui:Button Content="{DynamicResource Proxy_EnableSystemProxy}" Icon="{ui:SymbolIcon Wifi124}"
                           Style="{StaticResource AppButton}" Command="{Binding EnableSystemProxyCommand}"
                           Visibility="{Binding IsSystemProxyEnabled, Converter={StaticResource BoolToVisibilityInverse}}" />
                <ui:Button Content="{DynamicResource Proxy_DisableSystemProxy}" Icon="{ui:SymbolIcon WifiOff24}"
                           Style="{StaticResource AppButton}" Command="{Binding DisableSystemProxyCommand}"
                           Visibility="{Binding IsSystemProxyEnabled, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <!-- Scope note + live status -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}">
                    <Run Text="{DynamicResource Proxy_Banner}" />
                    <Run Text="  " />
                    <Run Text="{DynamicResource Proxy_CaLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Run Text=" " />
                    <Run FontFamily="Cascadia Mono, Consolas" Text="{Binding CaThumbprint, Mode=OneWay}"
                         Foreground="{StaticResource TextSecondaryBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Exchange list -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="1">
            <Grid ClipToBounds="True">
                <DataGrid x:Name="ExchangeGrid"
                          Background="Transparent" BorderThickness="0"
                          RowStyle="{StaticResource ExchangeRow}"
                          ItemsSource="{Binding Exchanges}"
                          SelectedItem="{Binding SelectedExchange}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="None" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource AppColumnHeader}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Time}" Binding="{Binding Time}" Width="96" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Method}" Binding="{Binding Method}" Width="72" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Scheme}" Binding="{Binding Scheme}" Width="62" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Host}" Binding="{Binding Host}" Width="190" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Path}" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Status}" Binding="{Binding Status}" Width="68" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Detail}" Binding="{Binding StatusDetail}" Width="140" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Size}" Binding="{Binding ResponseSize}" Width="72" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Duration}" Binding="{Binding Duration}" Width="112" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Style="{StaticResource EmptyState}"
                            Visibility="{Binding Exchanges.Count, Converter={StaticResource CountToVisibility}}">
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Text="{DynamicResource Proxy_EmptyState}" Style="{StaticResource EmptyStateText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Request/response detail -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="6" Height="268">
            <Grid>
                <TextBlock Style="{StaticResource EmptyStateText}" VerticalAlignment="Center" Panel.ZIndex="1"
                           IsHitTestVisible="False" Text="{DynamicResource Proxy_SelectExchange}"
                           Visibility="{Binding SelectedExchange, Converter={StaticResource NullToVisibility}}" />
                <TabControl Background="Transparent" BorderThickness="0"
                            Visibility="{Binding SelectedExchange, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                <TabItem Header="{DynamicResource Proxy_Tab_Request}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="84" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource SurfaceSunkenBrush}">
                            <TextBox Text="{Binding SelectedExchange.RequestHeadersText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <TextBox Text="{Binding SelectedExchange.RequestBodyText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Proxy_Tab_Response}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="84" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource SurfaceSunkenBrush}">
                            <TextBox Text="{Binding SelectedExchange.ResponseHeadersText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <TextBox Text="{Binding SelectedExchange.ResponseBodyText, Mode=OneWay}" Style="{StaticResource MonoText}" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
