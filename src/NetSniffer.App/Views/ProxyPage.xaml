<UserControl x:Class="NetSniffer.App.Views.ProxyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NetSniffer.App.Converters"
             xmlns:vm="clr-namespace:NetSniffer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProxyViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

        <Style x:Key="ExchangeRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource GlassDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#332E2E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Proxy_Port}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ui:TextBox Width="80" Margin="0,0,12,0"
                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                <ui:Button Content="{DynamicResource Proxy_Start}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                           Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding StartProxyCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityInverse}}"
                           Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Proxy_Stop}" Icon="{ui:SymbolIcon Stop24}" Appearance="Danger"
                           Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding StopProxyCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,8,0" />

                <ui:Button Content="{DynamicResource Proxy_Clear}" Icon="{ui:SymbolIcon Broom24}" Style="{StaticResource LiquidButtonStyle}" Command="{Binding ClearExchangesCommand}" Margin="0,0,20,0" />

                <ui:Button Content="{DynamicResource Proxy_InstallCert}"
                           Icon="{ui:SymbolIcon ShieldCheckmark24}" Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding InstallRootCertificateCommand}"
                           Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibilityInverse}}"
                           Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Proxy_UninstallCert}" Icon="{ui:SymbolIcon ShieldError24}" Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding UninstallRootCertificateCommand}"
                           Visibility="{Binding IsCaInstalled, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Proxy_ExportCert}" Icon="{ui:SymbolIcon ArrowExportUp24}" Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding ExportRootCertificateCommand}" Margin="0,0,20,0" />

                <ui:Button Content="{DynamicResource Proxy_EnableSystemProxy}" Icon="{ui:SymbolIcon Wifi124}" Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding EnableSystemProxyCommand}"
                           Visibility="{Binding IsSystemProxyEnabled, Converter={StaticResource BoolToVisibilityInverse}}"
                           Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Proxy_DisableSystemProxy}" Icon="{ui:SymbolIcon WifiOff24}" Style="{StaticResource LiquidButtonStyle}"
                           Command="{Binding DisableSystemProxyCommand}"
                           Visibility="{Binding IsSystemProxyEnabled, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,8,0" />
            </StackPanel>
        </Border>

        <!-- Ethics/scope banner + live status -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="14,10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Proxy_Banner}" />
                    <Run Text=" " />
                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource Proxy_CaLabel}" />
                    <Run Text=" " />
                    <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrightBrush}" Text="{Binding CaThumbprint, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Exchange list -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="1">
            <Grid>
                <DataGrid x:Name="ExchangeGrid"
                          Background="Transparent" RowStyle="{StaticResource ExchangeRowStyle}"
                          ItemsSource="{Binding Exchanges}"
                          SelectedItem="{Binding SelectedExchange}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Time}" Binding="{Binding Time}" Width="100" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Method}" Binding="{Binding Method}" Width="70" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Scheme}" Binding="{Binding Scheme}" Width="60" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Host}" Binding="{Binding Host}" Width="220" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Path}" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Status}" Binding="{Binding Status}" Width="70" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Detail}" Binding="{Binding StatusDetail}" Width="160" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Size}" Binding="{Binding ResponseSize}" Width="80" />
                        <DataGridTextColumn Header="{DynamicResource Proxy_Col_Duration}" Binding="{Binding Duration}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Exchanges.Count, Converter={StaticResource CountToVisibility}}"
                            IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" Style="{StaticResource EmptyStateIconStyle}" />
                    <TextBlock Text="{DynamicResource Proxy_EmptyState}" Style="{StaticResource EmptyStateTextStyle}"
                               MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Request/response detail -->
        <Border Grid.Row="6" Style="{StaticResource GlassCard}" Padding="4" Height="264">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="{DynamicResource Proxy_Tab_Request}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="90" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedExchange.RequestHeadersText, Mode=OneWay}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedExchange.RequestBodyText, Mode=OneWay}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Proxy_Tab_Response}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="90" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedExchange.ResponseHeadersText, Mode=OneWay}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedExchange.ResponseBodyText, Mode=OneWay}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
