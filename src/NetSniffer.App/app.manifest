<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Npcap restricts raw packet capture to elevated processes by default, so
    NetSniffer requests administrator rights up front rather than failing
    with a confusing "could not open adapter" error later.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /> <!-- Windows 10/11 -->
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        The newer SMI/2019 dpiAwareness="PerMonitorV2" element isn't
        registered on every Windows servicing branch and can make the whole
        manifest fail to activate (seen as "side-by-side configuration is
        incorrect"). The classic 2005 dpiAware element is universally
        supported and "true/pm" still means per-monitor DPI aware.
      -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>
</assembly>
